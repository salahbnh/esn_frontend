# Public API base URL (consumed by the browser + server). Backend REST API.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api

# NextAuth — canonical URL of this frontend and a random secret used to sign JWT/cookies.
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-with-a-random-32-byte-secret

# Keycloak (OIDC) — issuer is realm-scoped: <keycloak>/realms/<realm>
KEYCLOAK_ISSUER=http://localhost:8080/realms/esn
KEYCLOAK_CLIENT_ID=esn-frontend
# Public client in Keycloak has no secret; leave empty unless the client is confidential.
KEYCLOAK_CLIENT_SECRET=
